# Application
NODE_ENV=development
APP_NAME="NestJS Boilerplate"
HOST=0.0.0.0
PORT=3000
# Keep "api": Launchpad routes /api to the backend and everything else to the frontend
API_PREFIX=api
CORS_ORIGIN=*
# Express trust proxy (default trusts private-network proxies so rate limiting sees real client IPs)
TRUST_PROXY=loopback, linklocal, uniquelocal
# Process timezone (defaults to UTC)
TZ=UTC

# Rate limiting (window in ms, max requests per window)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Database (MySQL) — Launchpad injects these automatically
DB_HOST=localhost
DB_PORT=3306
DB_NAME=app_db
DB_USER=app
DB_PASSWORD=
DB_LOGGING=false
# Connection timezone, keep aligned with TZ (Z = UTC)
DB_TIMEZONE=Z

# JWT — generate each with `openssl rand -hex 32` (use different values).
# When blank they are derived from DB_PASSWORD (16+ chars); with neither, the app refuses to start.
JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Redis (queues; cache when CACHE_DRIVER=redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=app:

# Cache: memory | redis (TTL in seconds)
CACHE_DRIVER=memory
CACHE_TTL=600

# Mail (SMTP, used by the email job processor)
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="NestJS Boilerplate"

# Seeder (npm run seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Docker Compose only
APP_PORT=3000
MYSQL_ROOT_PASSWORD=
